<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SplitSpend.Gateway</RootNamespace>
    <AssemblyName>SplitSpend.Gateway</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- Ocelot API Gateway -->
    <PackageReference Include="Ocelot"                              Version="23.3.3" />
    <PackageReference Include="Ocelot.Provider.Consul"             Version="23.3.3" />
    <PackageReference Include="Ocelot.Provider.Polly"              Version="23.3.3" />

    <!-- Authentication / JWT -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.10" />

    <!-- Rate Limiting (built-in ASP.NET Core 8) -->
    <!-- System.Threading.RateLimiting is in-box -->

    <!-- Resilience -->
    <PackageReference Include="Polly"                              Version="8.4.1" />
    <PackageReference Include="Polly.Extensions.Http"              Version="3.0.0" />
    <PackageReference Include="Microsoft.Extensions.Http.Polly"    Version="8.0.10" />

    <!-- Service Discovery -->
    <PackageReference Include="Consul"                             Version="1.7.14.3" />

    <!-- Observability — OpenTelemetry -->
    <PackageReference Include="OpenTelemetry.Extensions.Hosting"          Version="1.9.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore"   Version="1.9.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http"         Version="1.9.0" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.9.0" />
    <PackageReference Include="Azure.Monitor.OpenTelemetry.Exporter"       Version="1.3.0" />

    <!-- Structured Logging -->
    <PackageReference Include="Serilog.AspNetCore"                 Version="8.0.3" />
    <PackageReference Include="Serilog.Sinks.File"                 Version="6.0.0" />
    <PackageReference Include="Serilog.Sinks.Seq"                  Version="8.0.0" />
    <PackageReference Include="Serilog.Enrichers.Environment"      Version="3.0.1" />
    <PackageReference Include="Serilog.Enrichers.Thread"           Version="4.0.0" />
    <PackageReference Include="Serilog.Enrichers.Context"          Version="4.6.2" />

    <!-- Health Checks -->
    <PackageReference Include="AspNetCore.HealthChecks.UI.Client"  Version="8.0.1" />

    <!-- Response Caching -->
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="8.0.1" />
  </ItemGroup>

</Project>
