{
  "Application": {
    "Name": "SplitSpend.Gateway",
    "Environment": "Development"
  },

  "Jwt": {
    "Issuer": "SplitSpend",
    "Audience": "SplitSpend.Clients",
    "SecretKey": "REPLACE_WITH_256BIT_SECRET_KEY_IN_ENVIRONMENT_VARIABLE"
  },

  "Consul": {
    "Host": "http://localhost:8500",
    "ServiceName": "api-gateway",
    "ServicePort": 5000,
    "HealthCheckPath": "/health",
    "HealthCheckInterval": "10s",
    "HealthCheckTimeout": "5s",
    "DeregisterCriticalServiceAfter": "30s"
  },

  "Ocelot": {
    "Consul": {
      "Host": "http://localhost:8500"
    }
  },

  "RateLimiting": {
    "GlobalIpLimit": {
      "PermitLimit": 100,
      "WindowSeconds": 60
    },
    "AuthenticatedUserLimit": {
      "PermitLimit": 300,
      "WindowSeconds": 60
    },
    "AuthEndpointLimit": {
      "PermitLimit": 5,
      "WindowSeconds": 60
    },
    "PaymentEndpointLimit": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    },
    "TransferEndpointLimit": {
      "PermitLimit": 5,
      "WindowSeconds": 60
    },
    "VendorPayEndpointLimit": {
      "PermitLimit": 20,
      "WindowSeconds": 60
    }
  },

  "Resilience": {
    "CircuitBreaker": {
      "FailureThreshold": 5,
      "SamplingDurationSeconds": 30,
      "MinimumThroughput": 10,
      "BreakDurationSeconds": 15
    },
    "Retry": {
      "MaxAttempts": 3,
      "DelayMs": 200
    },
    "TimeoutSeconds": 30
  },

  "OpenTelemetry": {
    "ServiceName": "SplitSpend.Gateway",
    "ServiceVersion": "1.0.0",
    "OtlpEndpoint": "http://localhost:4317",
    "AzureMonitorConnectionString": "REPLACE_WITH_APPLICATION_INSIGHTS_CONNECTION_STRING"
  },

  "Seq": {
    "ServerUrl": "http://localhost:5341"
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    }
  },

  "AllowedHosts": "*",

  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:5000"
      }
    }
  }
}
