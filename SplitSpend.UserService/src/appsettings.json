{
  "Application": {
    "Name": "SplitSpend.UserService",
    "Environment": "Development"
  },

  "ConnectionStrings": {
    "UserDb": "Server=localhost,1433;Database=SplitSpend_User;User Id=sa;Password=REPLACE_WITH_DB_PASSWORD;TrustServerCertificate=True;"
  },

  "Jwt": {
    "Issuer": "SplitSpend",
    "Audience": "SplitSpend.Clients",
    "SecretKey": "REPLACE_WITH_256BIT_SECRET_IN_ENV_VAR"
  },

  "Consul": {
    "Host": "http://localhost:8500",
    "ServiceName": "user-service",
    "ServicePort": 5002,
    "HealthCheckInterval": "10s",
    "HealthCheckTimeout": "5s",
    "DeregisterCriticalServiceAfter": "30s"
  },

  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "GroupId": "user-service-group",
    "UserRegisteredTopic": "user.registered",
    "UserCreatedTopic": "user.created",
    "UserUpdatedTopic": "user.updated",
    "UserDeletedTopic": "user.deleted"
  },

  "OpenTelemetry": {
    "ServiceName": "SplitSpend.UserService",
    "ServiceVersion": "1.0.0",
    "OtlpEndpoint": "http://localhost:4317",
    "AzureMonitorConnectionString": "REPLACE_WITH_APP_INSIGHTS_CONNECTION_STRING"
  },

  "Seq": {
    "ServerUrl": "http://localhost:5341"
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    }
  },

  "AllowedHosts": "*",

  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:5002"
      }
    }
  }
}
